---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_nexus_operator_name }}
  namespace: {{ klovercloud_nexus_namespace }}
spec:
  replicas: {{ klovercloud_nexus_replica }}
  selector:
    matchLabels:
      name: {{ klovercloud_nexus_operator_name }}
  template:
    metadata:
      labels:
        name: {{ klovercloud_nexus_operator_name }}
    spec:
      serviceAccountName: nexus-operator
      containers:
        - name: {{ klovercloud_nexus_operator_name }}
          # Replace this with the built image name
          image: {{ klovercloud_nexus_operator_image }}
          command:
          - nexus-operator
          imagePullPolicy: Always
          env:
            - name: WATCH_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: OPERATOR_NAME
              value: "nexus-operator"

---

apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  creationTimestamp: null
  name: {{ klovercloud_nexus_operator_role_name }}
  namespace: {{ klovercloud_nexus_namespace }}
rules:
- apiGroups:
  - ""
  resources:
  - pods
  - services
  - services/finalizers
  - endpoints
  - persistentvolumeclaims
  - events
  - configmaps
  - secrets
  verbs:
  - create
  - delete
  - get
  - list
  - patch
  - update
  - watch
- apiGroups:
  - apps
  resources:
  - deployments
  - daemonsets
  - replicasets
  - statefulsets
  verbs:
  - create
  - delete
  - get
  - list
  - patch
  - update
  - watch
- apiGroups:
  - monitoring.coreos.com
  resources:
  - servicemonitors
  verbs:
  - get
  - create
- apiGroups:
  - apps
  resourceNames:
  - nexus-operator
  resources:
  - deployments/finalizers
  verbs:
  - update
- apiGroups:
  - ""
  resources:
  - pods
  verbs:
  - get
- apiGroups:
  - apps
  resources:
  - replicasets
  - deployments
  verbs:
  - get
- apiGroups:
  - app.klovercloud.com
  resources:
  - '*'
  verbs:
  - create
  - delete
  - get
  - list
  - patch
  - update
  - watch

---
kind: RoleBinding
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: {{ klovercloud_nexus_operator_role_binding_name }}
  namespace: {{ klovercloud_nexus_namespace }}
subjects:
- kind: ServiceAccount
  name: {{ klovercloud_nexus_operator_service_account_name }}
roleRef:
  kind: Role
  name: {{ klovercloud_nexus_operator_role_name }}
  apiGroup: rbac.authorization.k8s.io

---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_nexus_operator_service_name }}
  namespace: {{ klovercloud_nexus_namespace }}
  annotations:
    prometheus.io/scrape: 'true'
    prometheus.io/path:   /
    prometheus.io/port:   '8081'
spec:
  selector:
      app: {{ klovercloud_nexus_app_label }}
      nexus_cr: {{ klovercloud_nexus_cr }}
  type: ClusterIP
  ports:
    - port: {{ klovercloud_nexus_operator_service_port }}
      targetPort: {{ klovercloud_nexus_operator_service_port }}

---

apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ klovercloud_nexus_operator_service_account_name }}
  namespace: {{ klovercloud_nexus_namespace }}

---
apiVersion: extensions/v1beta1
kind: Ingress
metadata:
  name: {{ klovercloud_nexus_ingress_name }}
  namespace: {{ klovercloud_nexus_namespace }}
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: "/"
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
spec:
  rules:
  - host: {{ klovercloud_nexus_ingress_host }}
    http:
      paths:
      - backend:
          serviceName: {{ klovercloud_nexus_operator_service_name }}
          servicePort: {{ klovercloud_nexus_operator_service_port }}
        path: "/"

---
apiVersion: apiextensions.k8s.io/v1beta1
kind: CustomResourceDefinition
metadata:
  name: nexus.app.klovercloud.com
  namespace: {{ klovercloud_nexus_namespace }}  
spec:
  group: app.klovercloud.com
  names:
    kind: Nexus
    listKind: NexusList
    plural: nexus
    singular: nexus
  scope: Namespaced
  subresources:
    status: {}
  validation:
    openAPIV3Schema:
      description: Nexus is the Schema for the nexus API
      properties:
        apiVersion:
          description: 'APIVersion defines the versioned schema of this representation
            of an object. Servers should convert recognized schemas to the latest
            internal value, and may reject unrecognized values. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources'
          type: string
        kind:
          description: 'Kind is a string value representing the REST resource this
            object represents. Servers may infer this from the endpoint the client
            submits requests to. Cannot be updated. In CamelCase. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds'
          type: string
        metadata:
          type: object
        spec:
          description: NexusSpec defines the desired state of Nexus
          type: object
        status:
          description: NexusStatus defines the observed state of Nexus
          type: object
      type: object
  version: v1alpha1
  versions:
  - name: v1alpha1
    served: true
    storage: true

---
apiVersion: app.klovercloud.com/v1alpha1
kind: Nexus
metadata:
  name: {{ klovercloud_nexus_cr }}
  namespace: {{ klovercloud_nexus_namespace }}
spec:
  # Add fields here
  replicas: {{ klovercloud_nexus_replica }}
  claim: nexus-claim-pvc
{% if profile  == "prod" %}
  resources:
    limits:
      memory: {{ klovercloud_nexus_memory_limit }}
      cpu: {{ klovercloud_nexus_cpu_limit }}
    requests:
      memory: {{ klovercloud_nexus_memory_request }}
      cpu: {{ klovercloud_nexus_cpu_request }}
{% endif %}


     

