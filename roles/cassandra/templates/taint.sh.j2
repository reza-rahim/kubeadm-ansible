
{% macro label() -%}
  {% for host in groups['kube-storage'] %} kubectl label nodes {{ host }}  dedicated={{ cassandra_taint }} ; {% endfor %}
{% endmacro -%}


{% macro taint() -%}
{% for host in groups['kube-storage'] %} kubectl taint nodes {{ host }} dedicated={{ cassandra_taint }}:NoSchedule ;  {% endfor %}


{% if profile  == "prod" %}
  {{ label() }} 
  {{ taint() }}
{% endif %}
