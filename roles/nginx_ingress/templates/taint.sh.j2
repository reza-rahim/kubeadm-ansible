{% endmacro -%}

{% macro taint() -%}
{% for host in groups['kube_ingress'] %} kubectl taint nodes {{ host }} dedicated=ingress:NoSchedule ;  {% endfor %}
{% endmacro -%}

{{ label() }} 

{% if profile  == "prod" %}
  {{ taint() }}
{% endif %}
