---
# Source: cortex/templates/querier-svc.yaml
apiVersion: v1
kind: Service
metadata:
  name: cortex-querier
  labels:
    chart: cortex-0.0.1
    release: cortex
    heritage: Helm
    cortex: querier
spec:
  ports:
    - port: 80
      name: http
      targetPort: http
  selector:
    app: cortex-querier
    release: cortex
---
# Source: cortex/templates/querier-dep.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cortex-querier
  labels:
    chart: cortex-0.0.1
    release: cortex
    heritage: Helm
    cortex: querier
spec:
  replicas: 3
  strategy:
    rollingUpdate:
      maxUnavailable: 1
  selector:
    matchLabels:
      app: cortex-querier
      release: cortex
  template:
    metadata:
      labels:
        app: cortex-querier
        release: cortex
        cortex: querier
      annotations:
        prometheus.io/port: "80"
        prometheus.io/scrape: "true"
        sidecar.istio.io/inject: "false"
    spec:

      {% if profile  == "prod" %}

      tolerations:
        - effect: NoSchedule
          key: dedicated
          operator: Equal
          value:  {{ cortex_taint }}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: dedicated
                operator: In
                values:
                - {{ cortex_taint }}
      {% endif %}

      containers:
      - name: querier
        #image: "quay.io/cortexproject/querier:master-79bba2f9"
        image: quay.io/cortexproject/cortex:v0.4.0
        imagePullPolicy: IfNotPresent
        args:
        - -target=querier
        - -log.level=debug
        - -server.http-listen-port=80
        - -config.file=/etc/cortex/config/config.yaml
        ports:
        - containerPort: 80
          name: http

{% if profile  == "prod" %}

        resources:
         limits:
           cpu: 1
         requests:
           cpu: 1
           memory: 1Gi
 {% endif %}

        volumeMounts:
        - mountPath: /etc/cortex/config
          name: cortex
      volumes:
        - configMap:
            name: cortex
          name: cortex

