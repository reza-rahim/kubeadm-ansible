---
# Source: cortex/templates/table-manager-svc.yaml
apiVersion: v1
kind: Service
metadata:
  name: cortex-table-manager
  labels:
    chart: cortex-0.0.1
    release: cortex
    heritage: Helm
    cortex: table-manager
spec:
  ports:
    - port: 80
      name: http
      targetPort: http
  selector:
    app: cortex-table-manager
    release: cortex

---
# Source: cortex/templates/table-manager-dep.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cortex-table-manager
  labels:
    chart: cortex-0.0.1
    release: cortex
    heritage: Helm
    cortex: table-manager
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cortex-table-manager
      release: cortex
  template:
    metadata:
      labels:
        app: cortex-table-manager
        release: cortex
        cortex: table-manager
      annotations:
        prometheus.io/port: "80"
        prometheus.io/scrape: "true"
        sidecar.istio.io/inject: "false"
    spec:
{% if cortex_taint is defined and profile  == "prod" %}

      tolerations:
        - key: dedicated
          operator: Equal
          value: {{ cortex_taint }}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: dedicated
                operator: In
                values:
                - {{ cortex_taint }}
{% endif %}

      containers:
      - name: table-manager
        image: "quay.io/cortexproject/cortex:v0.4.0"
        imagePullPolicy: IfNotPresent 
        args:
        - "-target=table-manager"
        - "-server.http-listen-port=80"
        - "-config.file=/etc/cortex/config/config.yaml"
        ports:
        - containerPort: 80
          name: http
{% if profile  == "prod" %}

        resources:
          limits:
            cpu: 200m
          requests:
            cpu: 200m
            memory: 256Mi
 {% endif %}

        volumeMounts:
        - mountPath: /etc/cortex/config
          name: cortex
      volumes:
        - configMap:
            name: cortex
          name: cortex
