---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_message_publisher_app_label }}
  namespace: klovercloud
spec:
  replicas: {{ klovercloud_message_publisher_deployment_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_message_publisher_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      labels:
        app: {{ klovercloud_message_publisher_app_label }}
    spec:
      terminationGracePeriodSeconds: 15
      containers:
      - name: app
        imagePullPolicy: Always
        image: {{ klovercloud_message_publisher_image }}
        resources:
          requests:
            cpu: {{ klovercloud_message_publisher_cpu_request }}
            memory: {{ klovercloud_message_publisher_memory_request }}
          limits:
            cpu: {{ klovercloud_message_publisher_cpu_limit }}
            memory: {{ klovercloud_message_publisher_memory_limit }}
        envFrom:
        - configMapRef:
            name: {{ klovercloud_message_publisher_envar_configmap_name }}
        ports:
        - containerPort: {{ klovercloud_message_publisher_container_port }}
        readinessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_message_publisher_container_port }}
          failureThreshold: 10
          initialDelaySeconds: 60
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        livenessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_message_publisher_container_port }}
          failureThreshold: 10
          initialDelaySeconds: 60
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
      imagePullSecrets:
      - name: regcred-dh


---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_message_publisher_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_message_publisher_app_label }}
spec:
  ports:
    - name: http-rest
      port: {{ klovercloud_message_publisher_service_port }}
      protocol: TCP
      targetPort: {{ klovercloud_message_publisher_container_port }}
  selector:
    app: {{ klovercloud_message_publisher_app_label }}