--- 

apiVersion: v1
kind: Service
metadata:
 name: {{ klovercloud_rook_ceph_my_store_service_name }}
 namespace: {{ klovercloud_rook_ceph_namespace }}
 labels:
   app: {{ klovercloud_rook_ceph_my_store_app_label }}
   rook_cluster: {{ klovercloud_rook_ceph_my_store_rook_cluster_label }}
   rook_object_store: {{ klovercloud_rook_ceph_my_store_rook_object_store_label }}
spec:
 ports:
 - name: rgw
   port: {{ klovercloud_rook_ceph_my_store_service_port }}
   protocol: TCP
   targetPort: {{ klovercloud_rook_ceph_my_store_service_target_port }}
 selector:
   app: {{ klovercloud_rook_ceph_my_store_app_label }}
   rook_cluster: {{ klovercloud_rook_ceph_my_store_rook_cluster_label }}
   rook_object_store: {{ klovercloud_rook_ceph_my_store_rook_object_store_label }}
 sessionAffinity: None

---

apiVersion: extensions/v1beta1
kind: Ingress
metadata:
  name: {{ klovercloud_rook_ceph_object_storage_ingress_name }}
  namespace: {{ klovercloud_rook_ceph_namespace }}
  annotations:
    kubernetes.io/ingress.class: "nginx"
    cert-manager.io/issuer: "letsencrypt-prod"
    nginx.ingress.kubernetes.io/rewrite-target: "/"
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  tls:
  - hosts:
    - {{ klovercloud_rook_ceph_object_storage_ingress_host }}
    secretName: {{ klovercloud_rook_ceph_object_storage_ingress_secret }}
  rules:
  - host: {{ klovercloud_rook_ceph_object_storage_ingress_host }}
    http:
      paths:
      - backend:
          serviceName: {{ klovercloud_rook_ceph_my_store_service_name }}
          servicePort: {{ klovercloud_rook_ceph_my_store_service_port }}
        path: "/"