---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_listener_deployment_name }}
  namespace: {{ klovercloud_namespace }}
spec:
  replicas: {{ klovercloud_listener_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_listener_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      annotations:
        prometheus.io/path: "/prometheus"
        prometheus.io/port: '8081'
        prometheus.io/scrape: 'true'
      labels:
        app: {{ klovercloud_listener_app_label }}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
      - name: {{ klovercloud_listener_deployment_name }}
        imagePullPolicy: Always
        image: {{ klovercloud_listener_image }}
{% if profile  == "prod" %}
        resources:
          requests:
            cpu: {{ klovercloud_listener_cpu_request }}
            memory: {{ klovercloud_listener_memory_request }}
          limits:
            cpu: {{ klovercloud_listener_cpu_limit }}
            memory: {{ klovercloud_listener_memory_limit }}
{% endif %}
        env:
        - name: MONGO_SERVER
          value: "{{ klovercloud_mongodb_service_name }}"
        - name: MONGO_PORT
          value: "{{ klovercloud_mongodb_service_port }}"
        - name: MONGO_AUTH_DATABASE
          value: "{{ klovercloud_mongo_auth_db_name }}"
        - name: MONGO_USERNAME
          value: "{{ klovercloud_mongo_root_username }}"
        - name: MONGO_PASSWORD
          value: "{{ klovercloud_mongodb_root_password }}"
        - name: KAFKA_SERVER
          value: "{{ klovercloud_kafka_io_kompose_service }}"
        - name: KAFKA_PORT
          value: "{{ klovercloud_kafka_service_port }}"
        - name: ZOO_KEEPER_SERVER
          value: "{{ klovercloud_zookeeper_io_kompose_service }}"
        - name: ZOO_KEEPER_PORT
          value: "{{ klovercloud_zookeeper_service_port }}"
        - name: ADMIN_USERNAME
          valueFrom:
            secretKeyRef:
              name: {{ klovercloud_super_admin_secret }}
              key: username
        - name: ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: {{ klovercloud_super_admin_secret }}
              key: password
        - name: KLOVERCLOUD_MANAGEMENT_SERVICE_NAME
          value: "{{ klovercloud_management_service_name }}"
        ports:
        - containerPort: {{ klovercloud_listener_container_port1 }}
        - containerPort: {{ klovercloud_listener_container_port2 }}
        readinessProbe:
          httpGet:
            path: /
            port: {{ klovercloud_listener_container_port1 }}
          failureThreshold: 6
          initialDelaySeconds: 30
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        livenessProbe:
          httpGet:
            path: /
            port: {{ klovercloud_listener_container_port1 }}
          failureThreshold: 6
          initialDelaySeconds: 30
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
      imagePullSecrets:
      - name: {{ klovercloud_image_pulling_secret }}

---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_listener_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_listener_app_label }}
spec:
  ports:
  - name: http-rest
    port: {{ klovercloud_listener_service_port }}
    protocol: TCP
    targetPort: {{ klovercloud_listener_target_port }}
  - name: http-metrics
    port: {{ klovercloud_listener_metrics_sevice_port }}
    protocol: TCP
    targetPort: {{ klovercloud_listener_metrics_sevice_target_port }}
  selector:
    app: {{ klovercloud_listener_app_label }}

---

apiVersion: extensions/v1beta1
kind: Ingress
metadata:
  name: {{ klovercloud_listener_ingress_name }}
  namespace: {{ klovercloud_namespace }}
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: "/"
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
spec:
  rules:
  - host: {{ klovercloud_listener_ingress_host }}
    http:
      paths:
      - backend:
          serviceName: {{ klovercloud_listener_service_name }}
          servicePort: {{ klovercloud_listener_service_port }}
        path: "/"