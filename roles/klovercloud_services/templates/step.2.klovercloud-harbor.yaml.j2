---

###### Klovercloud-harbor Deployment ######

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_harbor_deployment_name }}
  namespace: {{ klovercloud_namespace }}
spec:
  replicas: {{ klovercloud_harbor_deployment_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_harbor_deployement_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      labels:
        app: {{ klovercloud_harbor_deployement_app_label }}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
        - name: {{ klovercloud_harbor_deployement_app_label }}
          imagePullPolicy: Always
          image: {{ klovercloud_harbor_image }}
{% if profile  == "prod" %}
          resources:
            requests:
              cpu: {{ klovercloud_harbor_cpu_request }}
              memory: {{ klovercloud_harbor_memory_request }}
            limits:
              cpu: {{ klovercloud_harbor_cpu_limit }}
              memory: {{ klovercloud_harbor_memory_limit }}
{% endif %}
          env:
            - name: RUN_MODE
              value: "PRODUCTION"
            - name: DATABASE_CONNECTION_STR
              value: {{ klovercloud_harbor_db_connection_str }}
            - name: DATABASE_NAME
              value: {{ klovercloud_harbor_db_name }}
            - name: HARBOR_SERVICE_URL
              value: "https://{{ klovercloud_harbor_ingress_host }}"
            - name: HARBOR_ADMIN_AUTH_TOKEN
              value: "Basic  {{ (klovercloud_harbor_admin + ':' + klovercloud_harbor_admin_password) | b64encode }} "
            - name: PROJECT_QUOTAS_COUNT_LIMIT
              value: {{ klovercloud_harbor_project_quotas_count_limit }}
            - name: PROJECT_QUOTAS_STORAGE_LIMIT
              value: {{ klovercloud_harbor_project_quotas_storage_limit }}
          ports:
            - containerPort: {{ klovercloud_harbor_container_port }}
          readinessProbe:
            httpGet:
              path: /
              port: {{ klovercloud_harbor_container_port }}
            initialDelaySeconds: 30
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ klovercloud_harbor_container_port }}
            initialDelaySeconds: 30
            periodSeconds: 10
      imagePullSecrets:
        - name: {{ klovercloud_image_pulling_secret }}


---

###### Klovercloud-harbor service ######

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_harbor_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_harbor_deployement_app_label }}
spec:
  ports:
    - name: http-rest
      port: {{ klovercloud_harbor_service_port }}
      protocol: TCP
      targetPort: {{ klovercloud_harbor_service_target_port }}
  selector:
    app: {{ klovercloud_harbor_deployement_app_label }}