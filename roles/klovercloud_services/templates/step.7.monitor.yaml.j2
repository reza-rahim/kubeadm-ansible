---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_monitor_deployment_name }}
  namespace: {{ klovercloud_namespace }}
spec:
  replicas: {{ klovercloud_monitor_deployment_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_monitor_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      labels:
        app: {{ klovercloud_monitor_app_label }}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
      - name: {{ klovercloud_monitor_deployment_name }}
        imagePullPolicy: Always
        image: {{ klovercloud_monitor_image }}
{% if profile  == "prod" %}
        resources:
          requests:
            cpu: {{ klovercloud_monitor_cpu_request }}
            memory: {{ klovercloud_monitor_memory_request }}
          limits:
            cpu: {{ klovercloud_monitor_cpu_limit }}
            memory: {{ klovercloud_monitor_memory_limit }}
{% endif %}
        env:
        - name: DEVELOPER_ALIAS
          value: {{ klovercloud_developer_alias }}
        - name: RUN_MODE
          value: "PRODUCTION"
        - name: MANAGEMENT_SERVICE_URL
          value: "http://{{ klovercloud_management_service_name }}/"
        - name: PIPELINE_SERVICE_URL
          value: "http://{{ klovercloud_pipeline_service_name }}/"
        - name: DATABASE_SERVICE_URL
          value: "http://{{ klovercloud_database_service_name }}/"
        - name: DATABASE_CONNECTION_STR
          value: "mongodb://{{ klovercloud_mongo_root_username }}:{{ klovercloud_mongodd_root_password }}@{{ klovercloud_mongodb_service_name }}:{{ klovercloud_mongodb_service_port }}"
        - name: DATABASE_NAME
          value: {{ klovercloud_monitor_db_name }}
        - name: KAFKA_BROKER
          value: "{{ klovercloud_kafka_service_name }}:{{ klovercloud_kafka_service_port }}"
        - name: DEPLOYMENT_POD_FEED_KAFKA_TOPIC
          value: {{ klovercloud_monitor_deployment_pod_feed_kafka_topic }}
        - name: DEPLOYMENT_POD_FEED_KAFKA_GROUP_ID
          value: {{ klovercloud_monitor_deployment_pod_feed_kafka_group_id }}
        - name: DEPLOYMENT_POD_FEED_CLEANUP_TIMEOUT_HOURS
          value: {{ klovercloud_monitor_deployment_pod_feed_cleanup_timeout_hours }}
        - name: CLUSTER_AGENT_RESPONSE_KAFKA_TOPIC
          value: {{ klovercloud_monitor_deployment_cluster_agent_response_kafka_topic }}
        - name: CLUSTER_AGENT_RESPONSE_KAFKA_GROUP_ID
          value: {{ klovercloud_monitor_deployment_cluster_agent_response_kafka_group_id }}
        ports:
        - containerPort: {{ klovercloud_monitor_container_port }}
        readinessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_monitor_container_port }}
          initialDelaySeconds: 30
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_monitor_container_port }}
          initialDelaySeconds: 30
          periodSeconds: 10
      imagePullSecrets:
        - name: {{ klovercloud_image_pulling_secret }}

---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_monitor_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_monitor_app_label }}
spec:
  ports:
    - name: http-rest
      port: {{ klovercloud_monitor_service_port }}
      protocol: TCP
      targetPort: {{ klovercloud_monitor_service_target_port }}
  selector:
    app: {{ klovercloud_monitor_app_label }}