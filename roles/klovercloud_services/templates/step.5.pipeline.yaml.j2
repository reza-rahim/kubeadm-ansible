---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_pipeline_deployment_name }}
  namespace: {{ klovercloud_namespace }}
spec:
  replicas: {{ klovercloud_pipeline_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_pipeline_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      annotations:
        prometheus.io/path: "/prometheus"
        prometheus.io/port: '8081'
        prometheus.io/scrape: 'true'
      labels:
        app: {{ klovercloud_pipeline_app_label }}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
      - name: {{ klovercloud_pipeline_deployment_name }}
        imagePullPolicy: Always
        image: {{ klovercloud_pipeline_image }}
        resources:
          requests:
            cpu: {{ klovercloud_pipeline_cpu_request }}
            memory: {{ klovercloud_pipeline_memory_request }}
          limits:
            cpu: {{ klovercloud_pipeline_cpu_limit }}
            memory: {{ klovercloud_pipeline_memory_limit }}
        envFrom:
        - secretRef:
            name: {{ klovercloud_mongodb_secret }}
        - secretRef:
            name: {{ klovercloud_facade_secret }}
        - configMapRef:
            name: {{ klovercloud_pipeline_envar_configmap_name }}
        ports:
        - containerPort: {{ klovercloud_pipeline_container_port1 }}
        - containerPort: {{ klovercloud_pipeline_container_port2 }}
        readinessProbe:
          httpGet:
            path: /
            port: {{ klovercloud_pipeline_container_port1 }}
          failureThreshold: 6
          initialDelaySeconds: 80
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        livenessProbe:
          httpGet:
            path: /
            port: {{ klovercloud_pipeline_container_port1 }}
          failureThreshold: 6
          initialDelaySeconds: 80
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
      imagePullSecrets:
      - name: {{ klovercloud_image_pulling_secret }}

---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_pipeline_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_pipeline_app_label }}
spec:
  ports:
  - name: http-rest
    port: {{ klovercloud_pipeline_service_port }}
    protocol: TCP
    targetPort: {{ klovercloud_pipeline_service_target_port }}
  - name: http-metrics
    port: {{ klovercloud_pipeline_service_metrics_port }}
    protocol: TCP
    targetPort: {{ klovercloud_pipeline_service_metrics_target_port }}
  selector:
    app: {{ klovercloud_pipeline_app_label }}