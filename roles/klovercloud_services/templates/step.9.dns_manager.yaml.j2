---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_dns_manager_deployment_name }}
  namespace: {{ klovercloud_namespace }}
spec:
  replicas: {{ klovercloud_dns_manager_deployment_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_dns_manager_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      labels:
        app: {{ klovercloud_dns_manager_app_label }}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
      - name: {{ klovercloud_dns_manager_deployment_name }}
        imagePullPolicy: Always
        image: {{ klovercloud_dns_manager_image }}
{% if profile  == "prod" %}
        resources:
          requests:
            cpu: {{ klovercloud_dns_manager_cpu_request }}
            memory: {{ klovercloud_dns_manager_memory_request }}
          limits:
            cpu: {{ klovercloud_dns_manager_cpu_limit }}
            memory: {{ klovercloud_dns_manager_memory_limit }}
{% endif %}
        env:
        - name: DEVELOPER_ALIAS
          value: {{ klovercloud_developer_alias }}
        - name: RUN_MODE
          value: "PRODUCTION"
        - name: DNS_TECHNOLOGY
          value: "{{ klovercloud_dns_manager_dns_technology }}"
        - name: SERVER_PORT
          value: "{{ klovercloud_dns_manager_server_port }}"
        - name: DATABASE_CONNECTION_STRING
          value: "mongodb://{{ klovercloud_mongo_admin_username }}:{{ klovercloud_mongodd_root_password }}@{{ klovercloud_mongodb_service_name }}:{{ klovercloud_mongodb_service_port }}"
        - name: DATABASE_NAME
          value: "{{ klovercloud_dns_manager_database_name }}"
        - name: COREDNS_REDIS_HOST
          value: "{{ klovercloud_dns_manager_coredns_redis_host }}"
        - name: COREDNS_REDIS_PASS
          value: "{{ klovercloud_dns_manager_coredns_redis_pass }}"
        - name: AWS_ACCESS_KEY_ID
          value: "{{ klovercloud_dns_manager_aws_access_key_id }}"
        - name: AWS_SECRET_ACCESS_KEY
          value: "{{ klovercloud_dns_manager_aws_secret_access_key }}"
        ports:
        - containerPort: {{ klovercloud_dns_manager_container_port }}
        readinessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_dns_manager_container_port }}
          initialDelaySeconds: 30
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_dns_manager_container_port }}
          initialDelaySeconds: 30
          periodSeconds: 10
      imagePullSecrets:
        - name: {{ klovercloud_image_pulling_secret }}

---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_dns_manager_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_dns_manager_app_label }}
spec:
  ports:
    - name: http-rest
      port: {{ klovercloud_dns_manager_service_port }}
      protocol: TCP
      targetPort: {{ klovercloud_dns_manager_service_target_port }}
  selector:
    app: {{ klovercloud_dns_manager_app_label }}