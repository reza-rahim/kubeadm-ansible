---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_rook_ceph_object_storage_deployment_name }}
  namespace: {{ klovercloud_namespace }}
spec:
  replicas: {{ klovercloud_rook_ceph_object_storage_deployment_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_rook_ceph_object_storage_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      labels:
        app: {{ klovercloud_rook_ceph_object_storage_app_label }}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
        - name: {{ klovercloud_rook_ceph_object_storage_deployment_name }}
          imagePullPolicy: Always
          image: {{ klovercloud_rook_ceph_object_storage_image }}
{% if profile  == "prod" %}
          resources:
            requests:
              cpu: {{ klovercloud_rook_ceph_object_storage_cpu_request }}
              memory: {{ klovercloud_rook_ceph_object_storage_memory_request }}
            limits:
              cpu: {{ klovercloud_rook_ceph_object_storage_cpu_limit }}
              memory: {{ klovercloud_rook_ceph_object_storage_memory_limit }}
{% endif %}
          env:
            - name: RUN_MODE
              value: "PRODUCTION"
            - name: DATABASE_CONNECTION_STR
              value: "mongodb://{{ klovercloud_mongo_root_username }}:{{ klovercloud_mongodb_root_password }}@{{ klovercloud_mongodb_service_name }}:{{ klovercloud_mongodb_service_port }}"
            - name: DATABASE_NAME
              value: "{{ klovercloud_rook_ceph_object_storage_db_name }}"
            - name: MANAGEMENT_SERVICE_URL
              value: "http://{{ klovercloud_management_service_name }}/"
            - name: OBJECT_STORAGE_ENDPOINT
              value: "{{ klovercloud_rook_ceph_object_storage_end_point }}"
            - name: OBJECT_STORAGE_ADMIN_USER_ACCESS_KEY
              value: "{{ klovercloud_rook_ceph_object_storage_access_key }}"
            - name: OBJECT_STORAGE_ADMIN_USER_SECRET_KEY
              value: "{{ klovercloud_rook_ceph_object_storage_secret_key }}"
          ports:
            - containerPort: {{ klovercloud_rook_ceph_object_storage_container_port }}
          readinessProbe:
            httpGet:
              path: /health
              port: {{ klovercloud_rook_ceph_object_storage_container_port }}
            initialDelaySeconds: 30
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: {{ klovercloud_rook_ceph_object_storage_container_port }}
            initialDelaySeconds: 30
            periodSeconds: 10
      imagePullSecrets:
        - name: {{ klovercloud_image_pulling_secret }}


---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_rook_ceph_object_storage_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_rook_ceph_object_storage_app_label }}
spec:
  ports:
    - name: http-rest
      port: {{ klovercloud_rook_ceph_object_storage_service_port }}
      protocol: TCP
      targetPort: {{ klovercloud_rook_ceph_object_storage_service_target_port }}
  selector:
    app: {{ klovercloud_rook_ceph_object_storage_app_label }}