---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_log_manager_deployment_name }}
  namespace: {{ klovercloud_namespace }}
spec:
  replicas: {{ klovercloud_log_manager_deployment_replica }}
  selector:
    matchLabels:
      app: {{ klovercloud_log_manager_app_label }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 0
  minReadySeconds: 25
  template:
    metadata:
      labels:
        app: {{ klovercloud_log_manager_app_label }}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
      - name: {{ klovercloud_log_manager_deployment_name }}
        imagePullPolicy: Always
        image: klovercloud_log_manager_image
{% if profile  == "prod" %}
        resources:
          requests:
            cpu: {{ klovercloud_log_manager_cpu_request }}
            memory: {{ klovercloud_log_manager_memory_request }}
          limits:
            cpu: {{ klovercloud_log_manager_cpu_limit }}
            memory: {{ klovercloud_log_manager_memory_limit }}
{% endif %}
        env:
        - name: DEVELOPER_ALIAS
          value: {{ klovercloud_developer_alias }}
        - name: RUN_MODE
          value: "PRODUCTION"
        - name: USER_NAME
          value: "{{ loki_username }}"
        - name: PASSWORD
          value: "{{ loki_password }}"
        - name: LOKI_URL
          value: "https://{{ loki_url }}/"
        - name: LOKIWS_URL
          value: "ws://{{ loki_url }}/"
        ports:
        - containerPort: {{ klovercloud_log_manager_container_port }}
        readinessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_log_manager_container_port }}
          initialDelaySeconds: 60
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /health
            port: {{ klovercloud_log_manager_container_port }}
          initialDelaySeconds: 60
          periodSeconds: 10
      imagePullSecrets:
        - name: {{ klovercloud_image_pulling_secret }}

---

apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_log_manager_service_name }}
  namespace: {{ klovercloud_namespace }}
  labels:
    app: {{ klovercloud_log_manager_app_label }}
spec:
  ports:
    - name: http-rest
      port: {{ klovercloud_log_manager_service_port }}
      protocol: TCP
      targetPort: {{ klovercloud_log_manager_service_target_port }}
  selector:
    app: {{ klovercloud_log_manager_app_label }}