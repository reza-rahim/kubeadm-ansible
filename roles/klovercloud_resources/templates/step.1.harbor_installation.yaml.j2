# ------------------- redis statefulSet ------------------- #

# Source: harbor/templates/redis/statefulset.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ klovercloud_harbor_redis_statefulset_name }}
  namespace: {{ klovercloud_harbor_namespace }}
  labels:
    heritage: {{ klovercloud_harbor_heritage_label }}
    release: {{ klovercloud_harbor_release_label }}
    chart: {{ klovercloud_harbor_redis_chart_label }}
    app: {{ klovercloud_harbor_app_label }}
    component: {{ klovercloud_harbor_redis_component_label }}
spec:
  replicas: {{ klovercloud_harbor_redis_statefulset_replica }}
  serviceName: {{ klovercloud_harbor_redis_service_name }}
  selector:
    matchLabels:
      release: {{ klovercloud_harbor_release_label }}
      app: {{ klovercloud_harbor_app_label }}
      component: {{ klovercloud_harbor_redis_component_label }}
  template:
    metadata:
      namespace: {{ klovercloud_harbor_namespace }}
      labels:
        heritage: {{ klovercloud_harbor_heritage_label }}
        release: {{ klovercloud_harbor_release_label }}
        chart: {{ klovercloud_harbor_redis_chart_label }}
        app: {{ klovercloud_harbor_app_label }}
        component: {{ klovercloud_harbor_redis_component_label }}
    spec:
      securityContext:
        fsGroup: 999
      containers:
      - name: redis
        image: {{ klovercloud_harbor_redis_image }}
        imagePullPolicy: IfNotPresent
        livenessProbe:
          tcpSocket:
            port: 6379
          initialDelaySeconds: 300
          periodSeconds: 10
        readinessProbe:
          tcpSocket:
            port: 6379
          initialDelaySeconds: 1
          periodSeconds: 10
        volumeMounts:
        - name: data
          mountPath: /var/lib/redis
          subPath: 
  volumeClaimTemplates:
  - metadata:
      name: data
      labels:
        heritage: {{ klovercloud_harbor_heritage_label }}
        release: {{ klovercloud_harbor_release_label }}
        chart: {{ klovercloud_harbor_redis_chart_label }}
        app: {{ klovercloud_harbor_app_label }}
    spec:
      accessModes: ["ReadWriteOnce"]
      storageClassName: "rook-ceph-block"
      resources:
        requests:
          storage: {{ klovercloud_harbor_redis_storage }}

