# Source: harbor/templates/registry/registry-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: {{ klovercloud_harbor_registry_secret_name }}
  namespace: {{ klovercloud_harbor_namespace }}
  labels:
    heritage: {{ klovercloud_harbor_heritage_label }}
    release: {{ klovercloud_harbor_release_label }}
    chart: {{ klovercloud_harbor_redis_chart_label }}
    app: {{ klovercloud_harbor_app_label }}
type: Opaque
data:
  REGISTRY_HTTP_SECRET: "NnZqYlBTZGQzVVBvYVlxYw=="
  REGISTRY_REDIS_PASSWORD: ""

---

# ------------------- harbor registry configMap ------------------- #

# Source: harbor/templates/registry/registry-cm.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ klovercloud_harbor_registry_config_map_name }}
  namespace: {{ klovercloud_harbor_namespace }}
  labels:
    heritage: {{ klovercloud_harbor_heritage_label }}
    release: {{ klovercloud_harbor_release_label }}
    chart: {{ klovercloud_harbor_redis_chart_label }}
    app: {{ klovercloud_harbor_app_label }}
data:
  config.yml: |+
    version: 0.1
    log:
      level: info
      fields:
        service: registry
    storage:
      filesystem:
        rootdirectory: /storage
      cache:
        layerinfo: redis
      maintenance:
        uploadpurging:
          enabled: false
      delete:
        enabled: true
      redirect:
        disable: false
    redis:
      addr: "{{ klovercloud_harbor_redis_service_name }}:{{ klovercloud_harbor_redis_service_port }} "
      db: 2
    http:
      relativeurls: false
      addr: :5000
      # set via environment variable
      # secret: placeholder
      debug:
        addr: localhost:5001
    auth:
      token:
        issuer: harbor-token-issuer
        realm: "https://{{ klovercloud_harbor_ingress_host }}/service/token"
        rootcertbundle: /etc/registry/root.crt
        service: harbor-registry
    validation:
      disabled: true
    notifications:
      endpoints:
        - name: harbor
          disabled: false
          url: http://{{ klovercloud_harbor_core_service_name }}/service/notifications
          timeout: 3000ms
          threshold: 5
          backoff: 1s
          ignoredmediatypes:
            - application/vnd.docker.image.rootfs.diff.tar.gzip
            - application/vnd.docker.image.rootfs.foreign.diff.tar.gzip
            - application/vnd.oci.image.layer.v1.tar
            - application/vnd.oci.image.layer.v1.tar+gzip
            - application/vnd.oci.image.layer.v1.tar+zstd
            - application/vnd.oci.image.layer.nondistributable.v1.tar
            - application/vnd.oci.image.layer.nondistributable.v1.tar+gzip
            - application/vnd.oci.image.layer.nondistributable.v1.tar+zstd
            - application/octet-stream
  ctl-config.yml: |+
    ---
    protocol: "http"
    port: 8080
    log_level: info

---

# ------------------- harbor registry pvc ------------------- #

# Source: harbor/templates/registry/registry-pvc.yaml
kind: PersistentVolumeClaim
apiVersion: v1
metadata:
  name: {{ klovercloud_harbor_registry_pvc_name }}
  namespace: {{ klovercloud_harbor_namespace }}
  annotations:
    helm.sh/resource-policy: keep
  labels:
    heritage: {{ klovercloud_harbor_heritage_label }}
    release: {{ klovercloud_harbor_release_label }}
    chart: {{ klovercloud_harbor_redis_chart_label }}
    app: {{ klovercloud_harbor_app_label }}
    component: {{ klovercloud_harbor_registry_component_label }}
spec:
  accessModes: 
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ klovercloud_harbor_registry_storage }}
  storageClassName: rook-ceph-block

---

# ------------------- harbor registry deployment ------------------- #

# Source: harbor/templates/registry/registry-dpl.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ klovercloud_harbor_registry_deployment_name }}
  namespace: {{ klovercloud_harbor_namespace }}
  labels:
    heritage: {{ klovercloud_harbor_heritage_label }}
    release: {{ klovercloud_harbor_release_label }}
    chart: {{ klovercloud_harbor_redis_chart_label }}
    app: {{ klovercloud_harbor_app_label }}
    component: {{ klovercloud_harbor_registry_component_label }}
spec:
  replicas: {{ klovercloud_harbor_registry_deployment_replica }}
  strategy:
    type: RollingUpdate
  selector:
    matchLabels:
      release: {{ klovercloud_harbor_release_label }}
      app: {{ klovercloud_harbor_app_label }}
      component: {{ klovercloud_harbor_registry_component_label }}
  template:
    metadata:
      labels:
        heritage: {{ klovercloud_harbor_heritage_label }}
        release: {{ klovercloud_harbor_release_label }}
        chart: {{ klovercloud_harbor_redis_chart_label }}
        app: {{ klovercloud_harbor_app_label }}
        component: {{ klovercloud_harbor_registry_component_label }}
      annotations:
        checksum/configmap: 20830fd6a421ce49a487f8af4c7e78df1c1834a9988521afb723b785f9d6ee4c
        checksum/secret: 81b4224e59916bf05700e96290f221621c5ace62eea563481fbba8e11e11fa33
        checksum/secret-jobservice: 8403c4e65f1033efc62a5955eb080cac3220b9b56988531f9a5209369af6dfb7
        checksum/secret-core: b42f62fed5692c57233ba669c9d3fa9417139640f92964cd5b54a4f5390b0614
    spec:
      securityContext:
        fsGroup: 10000
      containers:
      - name: registry
        image: {{ klovercloud_harbor_registry_image }}
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /
            port: {{ klovercloud_harbor_registry_container_port1 }}
          initialDelaySeconds: 300
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /
            port: {{ klovercloud_harbor_registry_container_port1 }}
          initialDelaySeconds: 1
          periodSeconds: 10
        args: ["serve", "/etc/registry/config.yml"]
        envFrom:
        - secretRef:
            name: {{ klovercloud_harbor_registry_secret_name }}
        ports:
        - containerPort: {{ klovercloud_harbor_registry_container_port1 }}
        - containerPort: {{ klovercloud_harbor_registry_container_port2 }}
        volumeMounts:
        - name: registry-data
          mountPath: /storage
          subPath: 
        - name: registry-root-certificate
          mountPath: /etc/registry/root.crt
          subPath: tls.crt
        - name: registry-config
          mountPath: /etc/registry/config.yml
          subPath: config.yml
      - name: registryctl
        image: {{ klovercloud_harbor_registry_ctl_image }}
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /api/health
            port: {{ klovercloud_harbor_registry_ctl_container_port }}
          initialDelaySeconds: 300
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /api/health
            port: {{ klovercloud_harbor_registry_ctl_container_port }}
          initialDelaySeconds: 1
          periodSeconds: 10
        args: ["serve", "/etc/registry/config.yml"]
        envFrom:
        - secretRef:
            name: {{ klovercloud_harbor_registry_secret_name }}
        env:
          - name: CORE_SECRET
            valueFrom:
              secretKeyRef:
                name: {{ klovercloud_harbor_core_secret_name }}
                key: secret
          - name: JOBSERVICE_SECRET
            valueFrom:
              secretKeyRef:
                name: {{ klovercloud_harbor_jobservice_secret_name }}
                key: secret
        ports:
        - containerPort: {{ klovercloud_harbor_registry_ctl_container_port }}
        volumeMounts:
        - name: registry-data
          mountPath: /storage
          subPath: 
        - name: registry-config
          mountPath: /etc/registry/config.yml
          subPath: config.yml
        - name: registry-config
          mountPath: /etc/registryctl/config.yml
          subPath: ctl-config.yml
      volumes:
      - name: registry-root-certificate
        secret:
          secretName: {{ klovercloud_harbor_notary_secret_name }}
      - name: registry-config
        configMap:
          name: {{ klovercloud_harbor_registry_config_map_name }}
      - name: registry-data
        persistentVolumeClaim:
          claimName: {{ klovercloud_harbor_registry_pvc_name }}

---

# ------------------- harbor registry svc ------------------- #

# Source: harbor/templates/registry/registry-svc.yaml
apiVersion: v1
kind: Service
metadata:
  name: {{ klovercloud_harbor_registry_service_name }}
  namespace: {{ klovercloud_harbor_namespace }}
  labels:
    heritage: {{ klovercloud_harbor_heritage_label }}
    release: {{ klovercloud_harbor_release_label }}
    chart: {{ klovercloud_harbor_redis_chart_label }}
    app: {{ klovercloud_harbor_app_label }}
spec:
  ports:
    - name: registry
      port: {{ klovercloud_harbor_registry_service_registry_port }}
    - name: controller
      port: {{ klovercloud_harbor_registry_service_controller_port }}
  selector:
    release: {{ klovercloud_harbor_release_label }}
    app: {{ klovercloud_harbor_app_label }}
    component: {{ klovercloud_harbor_registry_component_label }}



