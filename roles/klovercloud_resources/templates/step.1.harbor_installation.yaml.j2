        - name: SCANNER_CLAIR_DATABASE_URL
          valueFrom:
              secretKeyRef:
                name: {{ klovercloud_harbor_clair_secret_name }}
                key: database
        - name: SCANNER_LOG_LEVEL
          value: "info"
        ports:
        - containerPort: {{ klovercloud_harbor_clair_adapter_container_port }}
      volumes:
      - name: config
        secret:
          secretName: {{ klovercloud_harbor_clair_secret_name }}

