---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ mywebsql_deployment_name }}
  labels:
    app: {{ mywebsql_deployment_name }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ mywebsql_deployment_name }}
  template:
    metadata:
      labels:
        app: {{ mywebsql_deployment_name }}
    spec:
      containers:
        - name: mywebsql
          image: {{ mywebsql_image }}
          imagePullPolicy: Always
          ports:
          - containerPort: {{ mywebsql_container_port }}
            name: http
            protocol: TCP
---
apiVersion: v1
kind: Service
metadata:
  name: {{ mywebsql_node_port_service_name }}
spec:
  type: NodePort
  selector:
    app: {{ mywebsql_deployment_name }}
  ports:
  - protocol: TCP
    port: {{ mywebsql_node_port_service_port }}
    targetPort: {{ mywebsql_node_port_service_target_port }}
    nodePort: {{ mywebsql_node_port_service_node_port }}
