{% macro label() -%}
{% for host in groups['kube_storage'] %} kubectl label nodes {{ host }}  dedicated={{ storage_taint }} ; {% endfor %}
{% endmacro -%}

{% macro taint() -%}
{% for host in groups['kube_storage'] %} kubectl taint nodes {{ host }} dedicated={{ storage_taint }}:NoSchedule ;  {% endfor %}
{% endmacro -%}

{{ label() }} 

{% if profile  == "prod" %}
  {{ taint() }}
{% endif %}
