helm  template -name monitoring --namespace=monitoring prometheus --set server.global.external_labels.cluster=one --set serverFiles."prometheus\.yml".remote_write[0].url=cortex_endpoint > prometheus.yaml

rm -rf prometheus

sed -i 's/cortex_endpoint/{{ cortex_endpoint }}/' prometheus.yaml 

ssh kube-master-0 "mkdir -p ~/prom"
scp  prometheus.yaml  kube-master-0:~/prom
ssh kube-master-0 "kubectl apply -f ~/prom"


# port forewarding
kubectl port-forward -n monitoring $( kubectl get pod -n monitoring  -l app=prometheus -l component=server -o jsonpath={.items..metadata.name} ) 9090

