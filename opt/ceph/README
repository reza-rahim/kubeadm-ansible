```bash
kubectl get namespace "rook-ceph" -o json   | tr -d "\n" | sed "s/\"finalizers\": \[[^]]\+\]/\"finalizers\": []/"  | kubectl replace --raw /api/v1/namespaces/rook-ceph/finalize -f -
```

